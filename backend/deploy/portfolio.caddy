# Installed as /etc/caddy/sites/portfolio.caddy by server-setup.sh. HTTPS for the API, certificates
# handled by Caddy. The box is shared with CraftClash: /etc/caddy/Caddyfile only imports sites/*.caddy
# and belongs to the craftclash deploy, so never edit it from here.
#
# `api` is proxied by Cloudflare (orange cloud), which caches the public GET responses (they carry
# Cache-Control + ETag) and absorbs traffic. Behind the proxy every connection comes from a
# Cloudflare address, so:
#   - only Cloudflare may connect: anything else gets 403, otherwise anyone could skip the proxy and
#     send a fake CF-Connecting-IP;
#   - the visitor's real IP comes from CF-Connecting-IP, which the login lockout and the contact
#     rate limit depend on.
# Cloudflare SSL/TLS mode must be "Full (strict)": Caddy still holds a real certificate.
# Ranges from https://www.cloudflare.com/ips/ (checked 2026-11-12). They rarely change; if
# Cloudflare adds one, requests from it get 403 until it is added here.

(portfolio_cloudflare_ranges) {
	remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
}

api.ntshptl.in {
	@direct not {
		import portfolio_cloudflare_ranges
	}
	respond @direct 403

	encode zstd gzip
	request_body {
		max_size 1MB
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	reverse_proxy 127.0.0.1:8100 {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}
}
