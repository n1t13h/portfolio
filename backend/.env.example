# Copy to .env (local) or /etc/portfolio/backend.env (server). One line per setting in
# app/core/config.py; a test keeps this file in sync with it.

DEBUG=false
DATABASE_URL=sqlite:///./portfolio.db
ALLOWED_ORIGINS=["https://portfolio.ntshptl.in"]

# Every admin route lives under /a/<ADMIN_PATH_PREFIX>. Generate: openssl rand -hex 24
ADMIN_PATH_PREFIX=
# Signs session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_SECONDS=7200
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_ACCOUNT=20
LOGIN_LOCKOUT_SECONDS=900

MAX_UPLOAD_BYTES=41943040
MAX_REQUEST_BODY_BYTES=1000000
MAX_IMAGE_PIXELS=100000000

# Cloudflare R2 (S3 API). Two buckets: public variants (served at CDN_BASE_URL) and private.
R2_ENDPOINT=
R2_PRESIGN_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
CDN_BASE_URL=https://cdn.ntshptl.in

UNSPLASH_ACCESS_KEY=
UNSPLASH_USER=ntshptl

# From @BotFather, and your chat id (message the bot, then open /getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CONTACT_MAX_PER_HOUR=5
CONTACT_MAX_PER_HOUR_GLOBAL=30
